# EmailJS (https://www.emailjs.com) - powers the /contact form, browser-only, no backend.
# Template variables expected: {{from_name}}, {{reply_to}}, {{message}}
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Public URL of the deployed site (used for sitemap, canonical links and social previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
